      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "count(hw_gpu_memory_limit_bytes) or count(obslab_ollama_models_loaded) or vector(0)",
          "legendFormat": "series",
          "refId": "A",
          "exemplar": false
        }
      ]
    },
