    {
      "type": "stat",
      "title": "API-equivalent cost (last 24h)",
      "description": "Local model is free; set OBSLAB_PRICE_IN/OUT to see what the same traffic would cost on an API.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
