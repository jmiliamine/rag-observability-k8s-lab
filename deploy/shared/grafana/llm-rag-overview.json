        {
          "expr": "rag:fallback:ratio15m",
          "legendFormat": "fallback",
          "refId": "A",
          "exemplar": false
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Workflow latency percentiles",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(gen_ai_invoke_workflow_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "exemplar": true
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_invoke_workflow_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "exemplar": true
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gen_ai_invoke_workflow_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C",
          "exemplar": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency per LangGraph node (p95)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, langgraph_node) (rate(rag_graph_node_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{langgraph_node}}",
          "refId": "A",
          "exemplar": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Model calls (OpenTelemetry GenAI conventions)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "title": "LLM / embeddings duration p95",
      "description": "",
