      "targets": [
        {
          "expr": "sum(increase(obslab_llm_cost_usd_total[24h])) or vector(0)",
          "legendFormat": "USD",
          "refId": "A",
          "exemplar": false
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Model errors / s by type",
      "description": "",
