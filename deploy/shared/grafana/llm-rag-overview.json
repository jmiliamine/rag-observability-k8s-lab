    {
      "type": "row",
      "title": "Host GPU and model server (task host:metrics)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      }
    },
    {
      "type": "timeseries",
      "title": "GPU memory",
      "description": "Host value, sent by `task host:metrics`: empty when the poller is not running. Other programs = used minus Ollama's share: on a laptop, the browser or the desktop can push the model out of GPU memory.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum(hw_gpu_memory_limit_bytes)",
          "legendFormat": "total",
          "refId": "A",
          "exemplar": true
        },
        {
          "expr": "sum(hw_gpu_memory_usage_bytes)",
          "legendFormat": "used",
          "refId": "B",
          "exemplar": true
        },
        {
          "expr": "sum(obslab_ollama_model_vram_bytes)",
          "legendFormat": "Ollama models",
          "refId": "C",
          "exemplar": true
        },
        {
          "expr": "sum(hw_gpu_memory_usage_bytes) - (sum(obslab_ollama_model_vram_bytes) or vector(0))",
          "legendFormat": "other programs",
          "refId": "D",
          "exemplar": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GPU busy and temperature",
      "description": "Host value, sent by `task host:metrics`: empty when the poller is not running.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "max(hw_gpu_utilization_ratio)",
          "legendFormat": "busy",
          "refId": "A",
          "exemplar": true
        },
        {
          "expr": "max(obslab_host_gpu_temperature_celsius) / 100",
          "legendFormat": "temperature / 100 \u00b0C",
          "refId": "B",
          "exemplar": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Model part running on the CPU",
      "description": "Host value, sent by `task host:metrics`: empty when the poller is not running. Above 0: the model did not fit in GPU memory and answers slow down a lot.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "sum(obslab_ollama_model_size_bytes - obslab_ollama_model_vram_bytes)",
          "legendFormat": "on CPU",
          "refId": "A",
          "exemplar": false
        }
      ]
    },
    {
      "type": "stat",
      "title": "Models loaded in Ollama",
      "description": "Host value, sent by `task host:metrics`: empty when the poller is not running. 0: the next question pays a cold load (time to first chunk spikes).",
