    {
      "type": "timeseries",
      "title": "Groundedness",
      "description": "Share of answer words found in the retrieved context. It shows answers drifting away from the notes. It does not show an answer that uses the same words to say the opposite.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 57
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
