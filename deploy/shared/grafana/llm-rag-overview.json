        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "max(obslab_ollama_models_loaded)",
          "legendFormat": "loaded",
          "refId": "A",
          "exemplar": false
        }
      ]
    },
    {
      "type": "stat",
      "title": "Host poller reporting",
